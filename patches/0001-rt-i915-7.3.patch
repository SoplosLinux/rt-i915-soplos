 		}
 
-		local_irq_enable();
+		intel_vblank_irq_enable();
 
 		timeout = schedule_timeout(timeout);
 
-		local_irq_disable();
+		intel_vblank_irq_disable();
 	}
 
 	finish_wait(wq, &wait);
