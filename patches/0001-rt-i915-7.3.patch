--- a/drivers/gpu/drm/i915/Kconfig
+++ b/drivers/gpu/drm/i915/Kconfig
@@ -3,7 +3,6 @@
 	tristate "Intel 8xx/9xx/G3x/G4x/HD Graphics"
 	depends on DRM
 	depends on X86 && PCI
-	depends on !PREEMPT_RT
 	select INTEL_GTT if X86
 	select INTERVAL_TREE
 	# we need shmfs for the swappable backing store, and in particular
--- a/drivers/gpu/drm/i915/display/intel_vblank.h
+++ b/drivers/gpu/drm/i915/display/intel_vblank.h
@@ -6,6 +6,7 @@
 #ifndef __INTEL_VBLANK_H__
 #define __INTEL_VBLANK_H__
 
+#include <linux/irqflags.h>
 #include <linux/ktime.h>
 #include <linux/types.h>
 
@@ -15,6 +16,34 @@
 struct intel_crtc;
 struct intel_crtc_state;
 
+/*
+ * On PREEMPT_RT spinlock_t is a sleeping lock, and the i915 display update
+ * path takes such locks (uncore->lock in the vblank section, plus others)
+ * inside the vblank evasion section, which otherwise runs with hard
+ * interrupts disabled. Sleeping with interrupts disabled is a bug, so on RT
+ * the section keeps interrupts enabled instead: evasion becomes best effort.
+ * An atomic update preempted past its vblank shows up as an "Atomic update
+ * failure" for that one frame, but can no longer sleep in atomic context.
+ * Xe does not take those locks in the section and keeps the strict behaviour.
+ *
+ * For the same reason the scanline is not sampled from inside tracepoints on
+ * RT: sampling it takes uncore->lock, and tracepoint probes run with
+ * preemption disabled.
+ */
+#if defined(I915) && defined(CONFIG_PREEMPT_RT)
+static inline void intel_vblank_irq_disable(void) {}
+static inline void intel_vblank_irq_enable(void) {}
+#define intel_vblank_irq_save(flags)		((flags) = 0)
+#define intel_vblank_irq_restore(flags)		((void)(flags))
+#define intel_trace_scanline(crtc)		0
+#else
+static inline void intel_vblank_irq_disable(void) { local_irq_disable(); }
+static inline void intel_vblank_irq_enable(void) { local_irq_enable(); }
+#define intel_vblank_irq_save(flags)		local_irq_save(flags)
+#define intel_vblank_irq_restore(flags)		local_irq_restore(flags)
+#define intel_trace_scanline(crtc)		intel_get_crtc_scanline(crtc)
+#endif
+
 struct intel_vblank_evade_ctx {
 	struct intel_crtc *crtc;
 	int min, max, vblank_start;
